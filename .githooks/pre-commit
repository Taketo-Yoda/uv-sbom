#!/bin/bash

# Pre-commit hook: Automatically format code with cargo fmt
# This ensures all commits have consistent formatting.

set -e

# Lint .claude/ conventions only when they (or the lint itself) are staged, so
# commits that don't touch .claude/ stay fast. The lint reads the working tree,
# not the index; CI lints the committed tree.
if git diff --cached --name-only -- .claude scripts/check-claude-conventions.sh | grep -q .; then
    echo "Running .claude/ convention lint..."
    bash scripts/check-claude-conventions.sh
fi

echo "Running cargo fmt..."
cargo fmt --all

# Stage any formatting changes
git diff --name-only | while read file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

echo "Pre-commit checks passed."
